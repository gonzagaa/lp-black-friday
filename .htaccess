# LP Black (/a-maior-black/): o cPanel publica o repositório inteiro (Git Version Control, sem .cpanel.yml),
# então o material interno responde 404, como na home. 404 e não 403: o 403 confirma que o arquivo existe.
#
# RedirectMatch é do mod_alias (o mesmo da home no ar). "Require all denied" não foi usado de propósito: exige
# AuthConfig e, se ela não estiver liberada, a pasta inteira devolve 500. Não usa RewriteEngine, para não anular
# regras de rewrite de pastas acima.
#
# Não interfere no quiz/api/.htaccess (PHP 8.3): o mod_alias soma as regras das duas pastas, e nenhuma destas casa
# com o que o quiz carrega. NÃO bloqueie aqui nada que a página carrega (css/, js/, data/, assets/, vendor/, quiz/).
<IfModule mod_alias.c>
  RedirectMatch 404 (?i)/(_referencia|_brandkit|_videos-fora-do-site|relatorios|scripts|shots|node_modules)(/|$)
  RedirectMatch 404 (?i)\.md$
  RedirectMatch 404 (?i)/package(-lock)?\.json$
  RedirectMatch 404 (?i)/componentes\.html$
  # log do PHP (o error_log do cPanel nasce na pasta do script, ex.: quiz/api/error_log) e qualquer *.log
  RedirectMatch 404 (?i)/error_log$
  RedirectMatch 404 (?i)\.log$
  # dotfiles e dotpastas em qualquer nível (.gitignore, .git, .htaccess, .cpanel.yml...), menos .well-known
  RedirectMatch 404 (?i)/\.(?!well-known(/|$))
</IfModule>

# ==============================
# CACHE (cache busting por ?v=, scripts/versao.mjs)
# ==============================
# O HTML é quem aponta para as versões novas: sempre revalida. Tudo o que ele carrega (CSS, JS, imagens, vídeos,
# fontes) sai com ?v=<versão do deploy>, então pode ficar um ano em cache: a versão nova é outra URL.
# "Header set" (e não "always") nos arquivos versionados: um 404 passageiro não pode ficar um ano em cache.
# Só mod_headers e FilesMatch (o mesmo que a home usa no ar). O quiz/api/ tem o próprio no-store (quiz/api/.htaccess).
<IfModule mod_headers.c>
  <FilesMatch "\.html?$">
    Header always set Cache-Control "no-cache, must-revalidate"
    Header always set X-LiteSpeed-Cache-Control "no-cache"
    Header always unset Expires
  </FilesMatch>

  <FilesMatch "\.(css|m?js|png|jpe?g|webp|avif|gif|svg|ico|woff2?|mp4|webm)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # data/planos.json (preços e checkouts): sempre fresco, sem ?v=
  <FilesMatch "\.json$">
    Header always set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# Cache de página do LiteSpeed desligado nesta pasta (e no quiz): o HTML sai sempre do disco
<IfModule LiteSpeed>
  CacheLookup off
</IfModule>
